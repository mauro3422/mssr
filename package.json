{
  "name": "@mauroprime/mssr",
  "version": "0.2.0",
  "description": "Modular Semantic Skill Router: portable advisory semantic routing, modular context, registry, and optional MCP facade.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "mssr-mcp": "./dist/mcp-server.js",
    "mssr-codex-mcp": "./dist/codex-mcp-server.js"
  },
  "files": [
    "dist",
    "config",
    "docs",
    "templates",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test:core": "node scripts/test-core.mjs",
    "test:trace-contract": "node scripts/test-trace-contract.mjs",
    "test:registry": "node scripts/test-registry.mjs",
    "test:mcp-provider": "node scripts/test-mcp-provider.mjs",
    "test:provider-config": "node scripts/test-provider-config.mjs",
    "test:mcp": "node scripts/test-mcp.mjs",
    "test:codex-standalone": "node scripts/test-codex-standalone.mjs",
    "test:router": "node scripts/test-skill-routing.mjs",
    "test:context": "node scripts/test-skill-context.mjs",
    "test:skill-context-loader": "node scripts/test-skill-context-loader.mjs",
    "test:project-context": "node scripts/test-project-context.mjs",
    "test:intent-normalizer": "node scripts/test-intent-normalizer.mjs",
    "test:skill-routing": "npm run build && npm run test:router",
    "test:skill-context": "npm run build && npm run test:context",
    "test": "npm run build && npm run test:core && npm run test:trace-contract && npm run test:context && npm run test:skill-context-loader && npm run test:project-context && npm run test:intent-normalizer && npm run test:registry && npm run test:mcp-provider && npm run test:provider-config && npm run test:mcp && npm run test:codex-standalone && npm run test:router",
    "audit": "python scripts/audit-skills.py",
    "verify": "npm run check && npm run test && npm run audit",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "skills",
    "routing",
    "registry",
    "agents",
    "mssr"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.24",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  }
}
