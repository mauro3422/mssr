  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "mssr-mcp": "./dist/mcp-server.js",
    "mssr-codex-mcp": "./dist/codex-mcp-server.js",
    "mssr-opencode-mcp": "./dist/opencode-mcp-server.js"
