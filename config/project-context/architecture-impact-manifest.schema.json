{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mauroprime.local/schemas/architecture-impact-manifest.schema.json",
  "title": "MSSR Architecture Impact Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "architectures"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "architectures": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/architectureImpactEntry"
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$"
    },
    "exactProjectRelativeRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320,
      "allOf": [
        { "not": { "pattern": "^/" } },
        { "not": { "pattern": "^[A-Za-z]:/" } },
        { "not": { "pattern": "\\\\" } },
        { "not": { "pattern": "(^|/)\\.\\.?(/|$)" } },
        { "not": { "pattern": "//" } },
        { "not": { "pattern": "[?*\\[\\]{}!#]" } }
      ]
    },
    "architectureImpactEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architectureId", "authorityRef", "impactRefs"],
      "properties": {
        "architectureId": {
          "$ref": "#/$defs/stableId"
        },
        "authorityRef": {
          "$ref": "#/$defs/exactProjectRelativeRef"
        },
        "contextRef": {
          "$ref": "#/$defs/stableId"
        },
        "impactRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/exactProjectRelativeRef"
          }
        }
      }
    }
  }
}
