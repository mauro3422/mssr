{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mauroprime.local/mssr/project-context-manifest.schema.json",
  "title": "MSSR modular project context manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "core": {
      "type": "array",
      "maxItems": 16,
      "default": [],
      "items": { "$ref": "#/$defs/core" }
    },
    "modules": {
      "type": "array",
      "maxItems": 96,
      "default": [],
      "items": { "$ref": "#/$defs/module" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$"
    },
    "topic": { "enum": ["architecture", "design", "law", "pattern", "vocabulary", "decision", "state", "phase", "reference", "operations", "other"] },
    "area": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 240 },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      }
    },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "description", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["context", "memory", "state"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 300 },
        "source": { "$ref": "#/$defs/source" },
        "topic": { "$ref": "#/$defs/topic" },
        "area": { "$ref": "#/$defs/area" },
        "maxChars": { "type": "integer", "minimum": 200, "maximum": 80000 }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "description", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["context", "memory", "state", "directive"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 300 },
        "source": { "$ref": "#/$defs/source" },
        "topic": { "$ref": "#/$defs/topic" },
        "area": { "$ref": "#/$defs/area" },
        "stages": { "type": "array", "maxItems": 6, "items": { "enum": ["start", "implement", "verify", "persist", "close", "resume"] }, "default": [] },
        "domains": { "type": "array", "maxItems": 8, "items": { "enum": ["roblox", "godot", "blender", "figma", "github", "git", "filesystem", "google-workspace", "openai-development", "artifacts", "browser", "coding", "opencode", "agent-orchestration", "skill-system", "other"] }, "default": [] },
        "actions": { "type": "array", "maxItems": 12, "items": { "enum": ["discover", "design", "create", "edit", "move", "review", "verify", "test", "debug", "optimize", "save", "recover", "version", "publish", "coordinate", "maintain", "document", "analyze"] }, "default": [] },
        "artifacts": { "type": "array", "maxItems": 12, "items": { "enum": ["code", "game", "project", "repository", "place-file", "backup", "ui", "animation", "model-3d", "asset", "document", "spreadsheet", "presentation", "diagram", "website", "skill", "mcp", "placement-system", "network-system", "resource-system"] }, "default": [] },
        "needs": { "type": "array", "maxItems": 12, "items": { "enum": ["official-docs", "safe-editing", "unit-tests", "playtest", "visual-qa", "device-testing", "performance", "scene-analysis", "backup", "integrity-verification", "version-control", "history-recovery", "cross-agent", "human-approval"] }, "default": [] },
        "signals": { "type": "array", "maxItems": 12, "items": { "enum": ["nominal", "error-observed", "warning-observed", "degraded-capability", "uncertainty", "conflicting-evidence", "repeated-friction", "manual-workaround", "missing-capability", "recovery-needed", "skill-gap", "reusable-pattern", "capability-discovery-needed", "additional-capability-needed", "tool-chain-needed", "provider-refresh-needed", "replan-needed"] }, "default": [] },
        "required": { "type": "boolean", "default": false },
        "priority": { "type": "integer", "minimum": -100, "maximum": 100, "default": 0 },
        "maxChars": { "type": "integer", "minimum": 200, "maximum": 80000 },
        "exclusiveGroup": { "$ref": "#/$defs/id" }
      },
      "allOf": [
        {
          "not": {
            "required": ["required", "exclusiveGroup"],
            "properties": { "required": { "const": true } }
          }
        }
      ]
    }
  }
}
