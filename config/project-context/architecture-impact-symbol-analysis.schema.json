{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mauroprime.local/schemas/architecture-impact-symbol-analysis.schema.json",
  "title": "MSSR Architecture Symbol Analysis Contract v1",
  "$ref": "#/$defs/hostEvidence",
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,79}$"
    },
    "architectureId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^(?!\\s)[^\\r\\n]*\\S$"
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,79}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "exactProjectRelativeRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320,
      "allOf": [
        { "not": { "pattern": "^/" } },
        { "not": { "pattern": "^[A-Za-z]:/" } },
        { "not": { "pattern": "\\\\" } },
        { "not": { "pattern": "(^|/)\\.\\.?(/|$)" } },
        { "not": { "pattern": "//" } },
        { "not": { "pattern": "[?*\\[\\]{}!#]" } }
      ]
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "language", "name", "aspect"],
      "properties": {
        "kind": { "const": "symbol" },
        "language": { "enum": ["typescript", "javascript"] },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^(?!\\s)[^\\r\\n]*\\S$"
        },
        "aspect": { "enum": ["signature", "body", "shape"] }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startLine", "endLine"],
      "properties": {
        "startLine": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "endLine": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      }
    },
    "observedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "availability", "structuralFingerprint"],
      "properties": {
        "selector": { "$ref": "#/$defs/selector" },
        "availability": { "const": "observed" },
        "structuralFingerprint": { "$ref": "#/$defs/fingerprint" },
        "location": { "$ref": "#/$defs/location" }
      }
    },
    "missingResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "availability"],
      "properties": {
        "selector": { "$ref": "#/$defs/selector" },
        "availability": { "const": "missing" }
      }
    },
    "unavailableResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "availability"],
      "properties": {
        "selector": { "$ref": "#/$defs/selector" },
        "availability": { "const": "unavailable" },
        "reasonCode": { "$ref": "#/$defs/reasonCode" }
      }
    },
    "result": {
      "oneOf": [
        { "$ref": "#/$defs/observedResult" },
        { "$ref": "#/$defs/missingResult" },
        { "$ref": "#/$defs/unavailableResult" }
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "architectureId", "ref", "selectors"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "architectureId": { "$ref": "#/$defs/architectureId" },
        "ref": { "$ref": "#/$defs/exactProjectRelativeRef" },
        "selectors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/selector" }
        }
      }
    },
    "hostEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "architectureId", "ref", "sourceRevision", "analyzerId", "fingerprintScheme", "results"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "architectureId": { "$ref": "#/$defs/architectureId" },
        "ref": { "$ref": "#/$defs/exactProjectRelativeRef" },
        "sourceRevision": { "$ref": "#/$defs/revision" },
        "analyzerId": { "$ref": "#/$defs/stableId" },
        "fingerprintScheme": { "$ref": "#/$defs/stableId" },
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/result" }
        }
      }
    },
    "normalizedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "architectureId", "relationshipClass", "evidenceClass", "ref", "sourceRevision", "analyzerId", "fingerprintScheme", "results"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "architectureId": { "$ref": "#/$defs/architectureId" },
        "relationshipClass": { "const": "declared" },
        "evidenceClass": { "const": "observed" },
        "ref": { "$ref": "#/$defs/exactProjectRelativeRef" },
        "sourceRevision": { "$ref": "#/$defs/revision" },
        "analyzerId": { "$ref": "#/$defs/stableId" },
        "fingerprintScheme": { "$ref": "#/$defs/stableId" },
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/result" }
        }
      }
    }
  }
}
