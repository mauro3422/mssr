{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mauroprime.local/mssr/skill-context-manifest.schema.json",
  "title": "MSSR skill context manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "core", "modules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "core": { "$ref": "#/$defs/source" },
    "modules": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/module" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 240 },
        "sections": { "type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } }
      },
      "oneOf": [
        { "required": ["path"], "not": { "required": ["sections"] } },
        { "required": ["sections"], "not": { "required": ["path"] } }
      ]
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$" },
        "description": { "type": "string", "minLength": 1, "maxLength": 300 },
        "source": { "$ref": "#/$defs/source" },
        "stages": { "type": "array", "maxItems": 6, "uniqueItems": true, "items": { "enum": ["start", "implement", "verify", "persist", "close", "resume"] } },
        "domains": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "enum": ["roblox", "godot", "blender", "figma", "github", "git", "filesystem", "google-workspace", "openai-development", "artifacts", "browser", "coding", "opencode", "agent-orchestration", "skill-system", "other"] } },
        "actions": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "enum": ["discover", "design", "create", "edit", "move", "review", "verify", "test", "debug", "optimize", "save", "recover", "version", "publish", "coordinate", "maintain", "document", "analyze"] } },
        "artifacts": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "enum": ["code", "game", "project", "repository", "place-file", "backup", "ui", "animation", "model-3d", "asset", "document", "spreadsheet", "presentation", "diagram", "website", "skill", "mcp", "placement-system", "network-system", "resource-system"] } },
        "needs": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "enum": ["official-docs", "safe-editing", "unit-tests", "playtest", "visual-qa", "device-testing", "performance", "scene-analysis", "backup", "integrity-verification", "version-control", "history-recovery", "cross-agent", "human-approval", "component-reuse"] } },
        "signals": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "enum": ["nominal", "error-observed", "warning-observed", "degraded-capability", "uncertainty", "conflicting-evidence", "repeated-friction", "manual-workaround", "missing-capability", "recovery-needed", "skill-gap", "reusable-pattern", "capability-discovery-needed", "additional-capability-needed", "tool-chain-needed", "provider-refresh-needed", "replan-needed"] } },
        "required": { "type": "boolean", "default": false },
        "priority": { "type": "integer", "minimum": -100, "maximum": 100, "default": 0 },
        "maxChars": { "type": "integer", "minimum": 200, "maximum": 160000 },
        "exclusiveGroup": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$" }
      },
      "allOf": [
        { "not": { "required": ["exclusiveGroup", "required"], "properties": { "required": { "const": true } } } }
      ]
    }
  }
}
